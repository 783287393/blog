{
  "_comment": "配置模板（等价 .env.example）。实际运行配置位于 runtime/config.development.json（已被 .gitignore 排除）。",
  "url": "http://localhost:2368/",
  "server": {
    "port": 2368,
    "host": "127.0.0.1"
  },
  "database": {
    "client": "sqlite3",
    "connection": {
      "filename": "<REPLACE>/runtime/content/data/ghost-local.db"
    }
  },
  "mail": {
    "transport": "Direct"
  },
  "logging": {
    "transports": ["file", "stdout"]
  },
  "process": "local",
  "security": {
    "staffDeviceVerification": false
  },
  "paths": {
    "contentPath": "<REPLACE>/runtime/content"
  }
}
